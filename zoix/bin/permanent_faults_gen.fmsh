addtst(test=[ACCUMULATOR], stimtype=[vcd], dictionary.enable=[1], stim=[vcd/accum.vcd],dut.stim=[ACCUMULATOR,tb.top_i.core_region_i.CORE.RISCV_CORE.Pipe.ACCL_generate.DSP.ACCUMULATOR],stim_options=[+TESTNAME=ACCUMULATOR] )

