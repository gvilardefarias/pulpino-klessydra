# Set fault generation constraints
FaultGenerate
{
   # Create faults on all reg types in hierarchy
 #   NA [0,1] { VARI "RCA.**" }
   # Create faults on all ports in hierarchy
    NA [0,1] { PORT "ACCUMULATOR.**" }
 #   NA [0,1] { PRIM "RCA.**" }
    #NA [0,1] { PORT "RCA.b" }
    #NA [R,F] { PORT "RCA.a" },  [R, F] slow-to-rise trans. fault, slow-to-fall trans. fault

# NA type { class "location"}, NA Not Attempted, 
# type"
# [0,1] stuck at 0, stuck at 1
# [R, F] slow-to-rise trans. fault, slow-to-fall trans. fault


# class:     ASGN assign fault, ARRY array fault, BRID bridge fault, PORT port fault, EXPR expression fault
#           PRIM primitive input or output fault, TRAN transition fault


}

