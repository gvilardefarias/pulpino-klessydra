  sg13g2_inv_1 U12(
      .Y(n16), .A(n8)
  );
  sg13g2_a22oi_1 U13(
      .Y(n8), .A1(warmup_pattern_cnt[4]), .A2(n5), .B1(warmup_pattern_cnt[5]), 
      .B2(n1)
  );
  sg13g2_inv_1 U14(
      .Y(n17), .A(n9)
  );
  sg13g2_a22oi_1 U15(
      .Y(n9), .A1(warmup_pattern_cnt[5]), .A2(n5), .B1(warmup_pattern_cnt[6]), 
      .B2(n1)
  );
  sg13g2_inv_1 U16(
