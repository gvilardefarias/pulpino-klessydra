      .Q(ncp_cnt[2]), .Q_N(), .D(n16), .RESET_B(reset), .CLK(n1)
  );
  sg13g2_dfrbp_1 ncp_cnt_reg_1_(
      .Q(ncp_cnt[1]), .Q_N(), .D(n15), .RESET_B(reset), .CLK(n1)
  );
  sg13g2_dfrbp_1 ncp_cnt_reg_0_(
      .Q(ncp_cnt[0]), .Q_N(), .D(n14), .RESET_B(reset), .CLK(n1)
  );
  sg13g2_buf_1 U3(
      .X(n1), .A(lbist_clock)
  );
  sg13g2_buf_1 U4(
      .X(n2), .A(scan_en)
  );
  sg13g2_inv_1 U5(
      .Y(n12), .A(n3)
  );
  sg13g2_a22oi_1 U6(
      .Y(n3), .A1(new_ncp_cnt[6]), .A2(n4), .B1(scan_en), .B2(ncp_cnt[7])
