  sg13g2_dfrbp_1 ncp_0_limit_reg_7_(
      .Q(ncp_0_limit[7]), .Q_N(n18), .D(n33), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_6_(
      .Q(), .Q_N(ncp_0_limit[6]), .D(n20), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_5_(
      .Q(), .Q_N(ncp_0_limit[5]), .D(n21), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_4_(
      .Q(), .Q_N(ncp_0_limit[4]), .D(n22), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_3_(
      .Q(), .Q_N(ncp_0_limit[3]), .D(n23), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_2_(
      .Q(), .Q_N(ncp_0_limit[2]), .D(n24), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_1_(
      .Q(n1), .Q_N(ncp_0_limit[1]), .D(n25), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_0_(
      .Q(), .Q_N(ncp_0_limit[0]), .D(n34), .RESET_B(n10), .CLK(n6)
