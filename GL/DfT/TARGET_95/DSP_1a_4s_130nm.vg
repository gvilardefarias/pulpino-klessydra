module DSP_gate2_tessent_lbist(ijtag_tck, test_clock, shift_clock_src, edt_lbist_clock, 
                               lbist_test_clock_out, to_edt_scan_in, from_edt_scan_out, 
                               ijtag_si, ijtag_so, lbist_en, lbist_reset, edt_update_in, 
                               edt_update_out, ccm_en, ccm_scan_in, ccm_scan_out, 
                               lbist_low_power_shift_en, scan_en_in, scan_en_out, 
                               shift_capture_clock_out, shift_en_out, capture_en_out, 
                               ncp, lbist_prpg_en, misr_accumulate_en, ijtag_reset, 
                               ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, edt_sib_en);
  input  ijtag_tck, test_clock, shift_clock_src, from_edt_scan_out, ijtag_si, 
         edt_update_in, ccm_en, ccm_scan_in, scan_en_in, ijtag_reset, 
         ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue;
  output [0:0] ncp;
  output edt_lbist_clock, lbist_test_clock_out, to_edt_scan_in, ijtag_so, 
         lbist_en, lbist_reset, edt_update_out, ccm_scan_out, 
         lbist_low_power_shift_en, scan_en_out, shift_capture_clock_out, 
         shift_en_out, capture_en_out, lbist_prpg_en, misr_accumulate_en, 
         edt_sib_en;

  wire [2:0] lbist_setup;
  wire [1:0] shift_clock_select, shift_clock_select_buf_out, 
             capture_phase_size;
  wire ijtag_ccm_tdr_0_, ccm_en_buf_out, ijtag_ce_ccm, ijtag_se_ccm, 
       ijtag_ue_ccm, lbist_en_int, lbist_en_buf_out, shift_phase_int, 
       shift_phase_buf_out, capture_en_int, capture_en_buf_out, 
       shift_clock_en_int, shift_clock_en_buf_out, capture_clock_en_int, 
       capture_clock_en_buf_out, test_clock_buf_out, scan_en_in_buf, 
       ccm_te_so_lbist_edt_sib, lbist_fsm_reset, lbist_sync_reset, ncp_int_0_, 
       n_7_net_, n_8_net_, n_9_net_, shift_clock_int, lbist_clock_disable_sync, 
       n_10_net_, n_11_net_, lbist_clock_en_int, prpg_en_int, misr_en_int, 
       ccm_te_si_lockup, ccm_le_so_lbist_ctrl, ccm_te_so_lbist_ctrl, 
       lbist_ctrl_bist_scan_out, lbist_run_mode, lbist_burn_in, warmup_done, 
       last_bit, last_vector, ccm_le_so_lbist_ctrl_signals, 
       ccm_te_so_lbist_ctrl_signals, lbist_done, lbist_clock_disable, 
       lbist_fsm_ccm_scan_out, ccm_te_so_lbist_fsm, lbist_edt_sib_scan_out, 
       n34, n39, n48, n49, n50, n51, n52, n53, n54, n55, n56, n57, n58, n59, 
       n60, n61, n62, n63, n64, n65, n66, n67, n68, n69, n70, n71, n72, n73, 
       n74, n75, n76, n77, n78, n79, n80, n81, n82, n83, n86, n88, n89, n90, 
       n91, n92;

  sg13g2_mux2_1 tessent_persistent_cell_scan_en_out_mux(
      .X(scan_en_out), .A0(scan_en_in_buf), .A1(shift_phase_buf_out), .S(n_7_net_)
  );
  sg13g2_and2_1 tessent_persistent_cell_edt_update_out_and(
      .X(edt_update_out), .A(edt_update_in), .B(n48)
  );
  sg13g2_mux2_1 tessent_persistent_cell_shift_en_out_mux(
      .X(shift_en_out), .A0(scan_en_in_buf), .A1(shift_clock_en_buf_out), .S(n_7_net_)
  );
  sg13g2_slgcp_1 tessent_persistent_cell_shift_capture_clock_gater_i(
      .GCLK(shift_capture_clock_out), .GATE(n_8_net_), .SCE(n_9_net_), .CLK(shift_clock_int)
  );
  sg13g2_slgcp_1 tessent_persistent_cell_lbist_test_clock_out_gater_i(
      .GCLK(lbist_test_clock_out), .GATE(n_10_net_), .SCE(n_11_net_), .CLK(shift_clock_int)
  );
  sg13g2_dfrbp_1 ijtag_so_reg(
      .Q(ijtag_so), .Q_N(n34), .D(n83), .RESET_B(n39), .CLK(ijtag_tck)
  );
  sg13g2_dfrbp_1 ijtag_ccm_tdr_reg_2_(
      .Q(n81), .Q_N(n49), .D(n89), .RESET_B(ijtag_reset), .CLK(ijtag_tck)
  );
  sg13g2_dfrbp_1 ijtag_ccm_tdr_reg_1_(
      .Q(n82), .Q_N(n50), .D(n90), .RESET_B(ijtag_reset), .CLK(ijtag_tck)
  );
  sg13g2_dfrbp_1 ijtag_ccm_tdr_reg_0_(
      .Q(ijtag_ccm_tdr_0_), .Q_N(), .D(n91), .RESET_B(ijtag_reset), .CLK(ijtag_tck)
  );
  sg13g2_dfrbp_1 ccm_te_si_lockup_reg(
