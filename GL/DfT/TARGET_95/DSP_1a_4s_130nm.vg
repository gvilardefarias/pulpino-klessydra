module DSP_gate2_tessent_occ_clk_i_sib(clock, reset, enable, capture_en, shift_en, 
                                       update_en, scan_in, from_scan_out, scan_out, 
                                       to_enable);
  input  clock, reset, enable, capture_en, shift_en, update_en, scan_in, 
         from_scan_out;
  output scan_out, to_enable;

  wire sib_latch, sib, n10, n13, n12, n14, n15, n1, n2, n3, n4, n5;

  sg13g2_dfrbp_1 sib_reg(
      .Q(sib), .Q_N(), .D(n15), .RESET_B(reset), .CLK(clock)
  );
  sg13g2_dfrbp_1 so_retime_reg(
      .Q(scan_out), .Q_N(), .D(sib), .RESET_B(n13), .CLK(n14)
  );
  sg13g2_dfrbp_1 sib_latch_reg(
      .Q(sib_latch), .Q_N(), .D(n12), .RESET_B(reset), .CLK(n14)
  );
  sg13g2_dfrbp_1 to_enable_int_reg(
      .Q(), .Q_N(n10), .D(sib_latch), .RESET_B(n13), .CLK(n14)
  );
  sg13g2_tiehi U3(
      .L_HI(n13)
  );
  sg13g2_nor2b_1 U4(
      .Y(to_enable), .A(n10), .B_N(enable)
  );
  sg13g2_a21o_1 U5(
      .X(n15), .A1(n1), .A2(sib), .B1(n2)
  );
  sg13g2_and4_1 U6(
      .X(n2), .A(n3), .B(shift_en), .C(enable), .D(n4)
  );
  sg13g2_inv_1 U7(
      .Y(n4), .A(capture_en)
  );
  sg13g2_mux2_1 U8(
      .X(n3), .A0(scan_in), .A1(from_scan_out), .S(sib_latch)
  );
  sg13g2_o21ai_1 U9(
      .Y(n1), .A1(capture_en), .A2(shift_en), .B1(enable)
  );
  sg13g2_inv_1 U10(
      .Y(n14), .A(clock)
  );
  sg13g2_mux2_1 U11(
      .X(n12), .A0(sib_latch), .A1(sib), .S(n5)
  );
  sg13g2_and2_1 U12(
      .X(n5), .A(update_en), .B(enable)
  );
endmodule

