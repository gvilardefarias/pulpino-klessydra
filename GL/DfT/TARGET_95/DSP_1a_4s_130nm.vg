  sg13g2_a221oi_1 U22(
      .Y(n26), .A1(ncp_1_limit[1]), .A2(n3), .B1(ncp_1_limit[0]), .B2(n8), .C1(n9)
  );
  sg13g2_a221oi_1 U23(
      .Y(n27), .A1(n3), .A2(ncp_1_limit[7]), .B1(ncp_1_limit[6]), .B2(n12), .C1(n14)
  );
  sg13g2_a221oi_1 U24(
      .Y(n28), .A1(ncp_1_limit[6]), .A2(n4), .B1(ncp_1_limit[5]), .B2(n12), .C1(n14)
  );
  sg13g2_a221oi_1 U25(
      .Y(n29), .A1(ncp_1_limit[5]), .A2(n3), .B1(ncp_1_limit[4]), .B2(n12), .C1(n14)
