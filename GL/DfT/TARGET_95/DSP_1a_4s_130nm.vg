  sg13g2_buf_1 U3(
      .X(n2), .A(scan_en)
  );
  sg13g2_buf_1 U4(
      .X(n3), .A(scan_en)
  );
  sg13g2_buf_1 U5(
      .X(n4), .A(scan_en)
  );
  sg13g2_inv_1 U6(
      .Y(n5), .A(clock)
  );
  sg13g2_inv_1 U7(
      .Y(n6), .A(n5)
  );
  sg13g2_inv_1 U8(
      .Y(n7), .A(n5)
  );
  sg13g2_buf_1 U9(
      .X(n8), .A(n12)
  );
  sg13g2_buf_1 U10(
      .X(n9), .A(n14)
  );
  sg13g2_buf_1 U11(
      .X(n10), .A(reset)
  );
  sg13g2_buf_1 U12(
      .X(n11), .A(reset)
  );
  sg13g2_a221oi_1 U13(
      .Y(n19), .A1(n12), .A2(ncp_1_limit[7]), .B1(n13), .B2(n3), .C1(n9)
