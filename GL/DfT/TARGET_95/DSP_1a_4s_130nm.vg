      .Q(ncp_limits_so_retime), .Q_N(), .D(n25), .RESET_B(n4), .CLK(n29)
  );
  sg13g2_dfrbp_1 counter_bist_scan_out_retime_reg(
      .Q(counter_bist_scan_out_retime), .Q_N(), .D(n26), .RESET_B(n4), .CLK(n29)
  );
  DSP_gate2_tessent_lbist_capture_phase_reg DSP_gate2_tessent_lbist_capture_phase_size_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_reset(n2), .reset(n12), 
      .scan_in(n30), .scan_out(capture_phase_size_so), .capture_phase_size(capture_phase_size)
  );
  DSP_gate2_tessent_lbist_warmup_pattern_cnt_reg DSP_gate2_tessent_lbist_warmup_pattern_cnt_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_reset(n2), .reset(n11), 
      .scan_in(capture_phase_size_so), .scan_out(warmup_pattern_cnt_so), .warmup_pattern_cnt(warmup_pattern_cnt)
  );
  DSP_gate2_tessent_lbist_counter DSP_gate2_tessent_lbist_counter_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_run_mode(lbist_run_mode), 
      .reset(n11), .ccm_scan_en(n6), .ccm_le_si(warmup_pattern_cnt_so), .ccm_le_so(lbist_counter_ccm_le_so), 
      .shift_phase(shift_phase), .prpg_en(prpg_en), .lbist_burn_in(lbist_burn_in), 
      .lbist_reset(lbist_reset), .lbist_scan_in(warmup_pattern_cnt_so), .lbist_scan_out(counter_bist_scan_out), 
      .ncp(ncp[0]), .ncp_0_limit(ncp_0_limit), .ncp_1_limit(ncp_1_limit), .last_bit(last_bit), 
      .vector_cnt_lsb(vector_cnt_lsb), .last_vector(last_vector)
  );
  DSP_gate2_tessent_lbist_sib_3 DSP_gate2_tessent_lbist_sib_i(
      .ijtag_reset(n12), .ijtag_sel(ijtag_sel), .ijtag_si(lbist_scan_in), .ijtag_ce(ijtag_ce), 
      .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_tck(ijtag_tck), .ccm_scan_en(n7), 
      .ccm_te_si(counter_bist_scan_out_retime), .ccm_te_so(ccm_te_so_lbist_sib), 
      .ijtag_so(lbist_sib_scan_out), .ijtag_from_so(n28), .ijtag_to_sel(sib_to_enable)
  );
  DSP_gate2_tessent_lbist_ncp_limits DSP_gate2_tessent_lbist_ncp_limits_i(
      .clock(lbist_clock), .lbist_reset(lbist_reset), .reset(n12), .ncp_0_limit(ncp_0_limit), 
      .ncp_1_limit(ncp_1_limit), .ccm_scan_en(n7), .ccm_le_si(lbist_sib_scan_out), 
      .ccm_le_so(ncp_limits_ccm_le_so), .scan_en(ncp_limits_scan_en), .scan_in(lbist_sib_scan_out), 
      .scan_out(ncp_limits_so)
  );
  DSP_gate2_tessent_lbist_sib_2 DSP_gate2_tessent_lbist_ncp_limits_sib_i(
      .ijtag_reset(n12), .ijtag_sel(ijtag_sel), .ijtag_si(lbist_sib_scan_out), 
      .ijtag_ce(ijtag_ce), .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_tck(ijtag_tck), 
      .ccm_scan_en(n8), .ccm_te_si(ncp_limits_so_retime), .ccm_te_so(ccm_te_so), 
      .ijtag_so(ccm_le_so), .ijtag_from_so(n27), .ijtag_to_sel(ncp_limits_sib_to_enable)
  );
  sg13g2_and2_1 U3(
      .X(n1), .A(n3), .B(n24)
  );
  sg13g2_buf_1 U4(
      .X(n2), .A(lbist_reset)
  );
  sg13g2_inv_1 U5(
      .Y(n3), .A(ccm_scan_en)
  );
  sg13g2_inv_1 U6(
      .Y(n5), .A(n3)
  );
  sg13g2_inv_1 U7(
      .Y(n6), .A(n3)
  );
  sg13g2_inv_1 U8(
      .Y(n7), .A(n3)
  );
  sg13g2_inv_1 U9(
      .Y(n8), .A(n3)
  );
  sg13g2_inv_1 U10(
      .Y(n9), .A(n1)
  );
  sg13g2_buf_1 U11(
      .X(n12), .A(n10)
  );
  sg13g2_buf_1 U12(
      .X(n11), .A(n10)
  );
  sg13g2_buf_1 U13(
      .X(n10), .A(ijtag_reset)
  );
  sg13g2_tiehi U14(
      .L_HI(n4)
  );
  sg13g2_nor2_1 U15(
      .Y(warmup_done), .A(n13), .B(n14)
  );
  sg13g2_nand4_1 U16(
      .Y(n14), .A(n15), .B(n16), .C(n17), .D(n18)
  );
  sg13g2_xnor2_1 U17(
      .Y(n18), .A(warmup_pattern_cnt[3]), .B(vector_cnt_lsb[3])
  );
  sg13g2_xnor2_1 U18(
      .Y(n17), .A(warmup_pattern_cnt[4]), .B(vector_cnt_lsb[4])
  );
  sg13g2_xnor2_1 U19(
      .Y(n16), .A(warmup_pattern_cnt[5]), .B(vector_cnt_lsb[5])
  );
  sg13g2_xnor2_1 U20(
      .Y(n15), .A(warmup_pattern_cnt[6]), .B(vector_cnt_lsb[6])
  );
  sg13g2_nand4_1 U21(
      .Y(n13), .A(n19), .B(n20), .C(n21), .D(n22)
  );
  sg13g2_xnor2_1 U22(
      .Y(n22), .A(warmup_pattern_cnt_so), .B(vector_cnt_lsb[0])
  );
  sg13g2_xnor2_1 U23(
      .Y(n21), .A(warmup_pattern_cnt[1]), .B(vector_cnt_lsb[1])
  );
  sg13g2_xnor2_1 U24(
      .Y(n20), .A(warmup_pattern_cnt[2]), .B(vector_cnt_lsb[2])
  );
  sg13g2_xnor2_1 U25(
      .Y(n19), .A(warmup_pattern_cnt[7]), .B(vector_cnt_lsb[7])
  );
  sg13g2_mux2_1 U26(
      .X(n25), .A0(ncp_limits_so), .A1(ccm_te_so_lbist_sib), .S(n5)
  );
  sg13g2_mux2_1 U27(
      .X(n26), .A0(counter_bist_scan_out), .A1(ccm_te_si), .S(n5)
  );
  sg13g2_mux2_1 U28(
      .X(n27), .A0(ncp_limits_so_retime), .A1(ncp_limits_so), .S(n5)
  );
  sg13g2_mux2_1 U29(
      .X(n28), .A0(counter_bist_scan_out_retime), .A1(ncp[0]), .S(n5)
  );
  sg13g2_inv_1 U30(
      .Y(n29), .A(ijtag_tck)
  );
  sg13g2_mux2_1 U31(
      .X(n30), .A0(lbist_scan_in), .A1(ccm_le_si), .S(n8)
  );
  sg13g2_nand2_1 U32(
      .Y(ncp_limits_scan_en), .A(n3), .B(n23)
  );
  sg13g2_nand3_1 U33(
      .Y(n23), .A(ncp_limits_sib_to_enable), .B(lbist_en), .C(ijtag_se)
  );
  sg13g2_nand3_1 U34(
      .Y(n24), .A(ijtag_se), .B(lbist_en), .C(sib_to_enable)
  );
