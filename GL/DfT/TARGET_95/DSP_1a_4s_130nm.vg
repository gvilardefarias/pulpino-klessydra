  sg13g2_a221oi_1 U20(
      .Y(n24), .A1(ncp_0_limit[3]), .A2(n3), .B1(ncp_0_limit[2]), .B2(n8), .C1(n9)
  );
  sg13g2_a221oi_1 U21(
      .Y(n25), .A1(ncp_0_limit[2]), .A2(n4), .B1(ncp_0_limit[1]), .B2(n8), .C1(n9)
