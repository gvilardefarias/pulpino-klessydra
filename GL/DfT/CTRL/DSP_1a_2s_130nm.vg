  sg13g2_dfrbp_1 ncp_0_limit_reg_7_(
      .Q(ncp_0_limit[7]), .Q_N(n18), .D(n33), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_6_(
      .Q(), .Q_N(ncp_0_limit[6]), .D(n20), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_5_(
