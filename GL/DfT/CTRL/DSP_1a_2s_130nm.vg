       n14, n15, n17, n18, n20, n21, n23, n24, n26, n27, n29, n31, n33, n35, 
       n37, n39, n41, n43, n52, n53, n54, n55, n56, n57, n58, n59, n60, n62, 
       n63, n64, n65, n66, n67, n68, n69, n70, n71, n72, n87, n101, n102, n103, 
       n104, n105, n106, n107, n108, n1, n4, n7, n10, n13, n16, n19, n22, n25, 
       n30, n32, n34, n36, n38, n40, n42, n44, n45, n46, n47, n48, n49, n50, 
       n61, n73, n74, n75, n76, n77, n78, n79, n80, n81, n82, n83, n84, n85, 
       n86, n88, n89, n90, n91, n92, n93, n94, n95, n96, n97, n98, n99;

  DSP_gate2_tessent_edt_c1_xor_decoder xor_decoder(
      .encoded_masks({masks_hold_reg_0[0], masks_hold_reg_0[1], 
      masks_hold_reg_0[2], masks_hold_reg_0[3], masks_hold_reg_0[4], 
      masks_hold_reg_0[5]}), .decoded_masks_0(xor_decoded_masks_0)
  );
  DSP_gate2_tessent_edt_c1_onehot_decoder_4_to_10 decoder1(
      .encoded_masks({masks_hold_reg_0[5], n61, masks_hold_reg_0[3:2]}), .decoded_masks(onehot_decoded_masks_0)
  );
  DSP_gate2_tessent_edt_c1_sib_2 DSP_gate2_tessent_edt_c1_sib_i(
      .ijtag_tck(ijtag_tck), .ijtag_reset(ijtag_reset), .ijtag_sel(ijtag_sel), 
      .ijtag_ce(ijtag_ce), .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_si(ijtag_si), 
      .ijtag_from_so(n54), .ccm_scan_en(ccm_scan_en), .ccm_te_si(ccm_te_si), .ccm_te_so(ccm_te_so), 
