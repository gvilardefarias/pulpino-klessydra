module DSP_gate2_tessent_occ_clk_i(fast_clock, slow_clock, scan_en, capture_en, 
                                   static_clock_control_mode, clock_sequence, shift_only_mode, 
                                   ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
                                   ijtag_se, ijtag_ue, ijtag_si, ijtag_so, clock_out, 
                                   scan_in, scan_out);
  input  [2:0] clock_sequence;
  input  fast_clock, slow_clock, scan_en, capture_en, 
         static_clock_control_mode, shift_only_mode, ijtag_tck, ijtag_reset, 
         ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, ijtag_si, scan_in;
  output ijtag_so, clock_out, scan_out;

  wire [2:0] clock_sequence_buf_out;
  wire fast_clock_buf_out, slow_clock_buf_out, scan_en_buf_out, 
       capture_en_buf_out, static_clock_control_mode_buf_out, scan_in_buf_out, 
       scan_out_buf_in, slow_clock_nf_en, slow_clock_nf, inject_tck, 
       slow_clock_tck_injected, fast_clock_en, slow_clock_en, clock_mux_select, 
       fast_clock_gated, slow_clock_gated;

  sg13g2_slgcp_1 tessent_persistent_cell_cgc_slow_clock_nf(
      .GCLK(slow_clock_nf), .GATE(slow_clock_nf_en), .SCE(slow_clock_nf_en), .CLK(slow_clock_buf_out)
  );
  sg13g2_mux2_1 tessent_persistent_cell_inject_tck_mux(
      .X(slow_clock_tck_injected), .A0(slow_clock_nf), .A1(ijtag_tck), .S(inject_tck)
  );
  DSP_gate2_tessent_occ_clk_i_control occ_control(
