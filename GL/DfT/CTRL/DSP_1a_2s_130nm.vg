  DSP_gate2_tessent_lbist_sib_3 DSP_gate2_tessent_lbist_sib_i(
      .ijtag_reset(n12), .ijtag_sel(ijtag_sel), .ijtag_si(lbist_scan_in), .ijtag_ce(ijtag_ce), 
      .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_tck(ijtag_tck), .ccm_scan_en(n7), 
      .ccm_te_si(counter_bist_scan_out_retime), .ccm_te_so(ccm_te_so_lbist_sib), 
      .ijtag_so(lbist_sib_scan_out), .ijtag_from_so(n28), .ijtag_to_sel(sib_to_enable)
  );
  DSP_gate2_tessent_lbist_ncp_limits DSP_gate2_tessent_lbist_ncp_limits_i(
      .clock(lbist_clock), .lbist_reset(lbist_reset), .reset(n12), .ncp_0_limit(ncp_0_limit), 
      .ncp_1_limit(ncp_1_limit), .ccm_scan_en(n7), .ccm_le_si(lbist_sib_scan_out), 
      .ccm_le_so(ncp_limits_ccm_le_so), .scan_en(ncp_limits_scan_en), .scan_in(lbist_sib_scan_out), 
      .scan_out(ncp_limits_so)
  );
  DSP_gate2_tessent_lbist_sib_2 DSP_gate2_tessent_lbist_ncp_limits_sib_i(
      .ijtag_reset(n12), .ijtag_sel(ijtag_sel), .ijtag_si(lbist_sib_scan_out), 
      .ijtag_ce(ijtag_ce), .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_tck(ijtag_tck), 
      .ccm_scan_en(n8), .ccm_te_si(ncp_limits_so_retime), .ccm_te_so(ccm_te_so), 
      .ijtag_so(ccm_le_so), .ijtag_from_so(n27), .ijtag_to_sel(ncp_limits_sib_to_enable)
