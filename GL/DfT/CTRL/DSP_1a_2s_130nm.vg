  sg13g2_nor2_1 U14(
      .Y(ijtag_to_sel), .A(n6), .B(n10)
  );
  sg13g2_inv_1 U15(
      .Y(n6), .A(ijtag_sel)
  );
  sg13g2_dllrq_1 retiming_so_reg(
      .Q(ijtag_so), .D(sib), .RESET_B(n16), .GATE_N(ijtag_tck)
  );
  sg13g2_dfrbp_1 sib_reg(
      .Q(sib), .Q_N(), .D(n15), .RESET_B(n16), .CLK(ijtag_tck)
