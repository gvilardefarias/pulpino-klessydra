      .Q(counter_bist_scan_out_retime), .Q_N(), .D(n26), .RESET_B(n4), .CLK(n29)
  );
  DSP_gate2_tessent_lbist_capture_phase_reg DSP_gate2_tessent_lbist_capture_phase_size_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_reset(n2), .reset(n12), 
      .scan_in(n30), .scan_out(capture_phase_size_so), .capture_phase_size(capture_phase_size)
  );
  DSP_gate2_tessent_lbist_warmup_pattern_cnt_reg DSP_gate2_tessent_lbist_warmup_pattern_cnt_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_reset(n2), .reset(n11), 
      .scan_in(capture_phase_size_so), .scan_out(warmup_pattern_cnt_so), .warmup_pattern_cnt(warmup_pattern_cnt)
  );
  DSP_gate2_tessent_lbist_counter DSP_gate2_tessent_lbist_counter_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(n9), .lbist_run_mode(lbist_run_mode), 
      .reset(n11), .ccm_scan_en(n6), .ccm_le_si(warmup_pattern_cnt_so), .ccm_le_so(lbist_counter_ccm_le_so), 
      .shift_phase(shift_phase), .prpg_en(prpg_en), .lbist_burn_in(lbist_burn_in), 
      .lbist_reset(lbist_reset), .lbist_scan_in(warmup_pattern_cnt_so), .lbist_scan_out(counter_bist_scan_out), 
      .ncp(ncp[0]), .ncp_0_limit(ncp_0_limit), .ncp_1_limit(ncp_1_limit), .last_bit(last_bit), 
      .vector_cnt_lsb(vector_cnt_lsb), .last_vector(last_vector)
