  sg13g2_inv_1 U29(
      .Y(n33), .A(n16)
  );
  sg13g2_a22oi_1 U30(
      .Y(n16), .A1(n8), .A2(ncp_0_limit[7]), .B1(ncp_1_limit[0]), .B2(n2)
