  );
  sg13g2_inv_1 U8(
      .Y(n7), .A(n3)
  );
  sg13g2_inv_1 U9(
      .Y(n8), .A(n3)
  );
  sg13g2_inv_1 U10(
      .Y(n9), .A(n1)
  );
  sg13g2_buf_1 U11(
      .X(n12), .A(n10)
  );
  sg13g2_buf_1 U12(
      .X(n11), .A(n10)
  );
  sg13g2_buf_1 U13(
      .X(n10), .A(ijtag_reset)
  );
  sg13g2_tiehi U14(
      .L_HI(n4)
  );
  sg13g2_nor2_1 U15(
      .Y(warmup_done), .A(n13), .B(n14)
  );
  sg13g2_nand4_1 U16(
      .Y(n14), .A(n15), .B(n16), .C(n17), .D(n18)
  );
  sg13g2_xnor2_1 U17(
      .Y(n18), .A(warmup_pattern_cnt[3]), .B(vector_cnt_lsb[3])
  );
  sg13g2_xnor2_1 U18(
      .Y(n17), .A(warmup_pattern_cnt[4]), .B(vector_cnt_lsb[4])
  );
  sg13g2_xnor2_1 U19(
      .Y(n16), .A(warmup_pattern_cnt[5]), .B(vector_cnt_lsb[5])
  );
  sg13g2_xnor2_1 U20(
      .Y(n15), .A(warmup_pattern_cnt[6]), .B(vector_cnt_lsb[6])
  );
  sg13g2_nand4_1 U21(
      .Y(n13), .A(n19), .B(n20), .C(n21), .D(n22)
  );
  sg13g2_xnor2_1 U22(
      .Y(n22), .A(warmup_pattern_cnt_so), .B(vector_cnt_lsb[0])
  );
  sg13g2_xnor2_1 U23(
      .Y(n21), .A(warmup_pattern_cnt[1]), .B(vector_cnt_lsb[1])
  );
  sg13g2_xnor2_1 U24(
      .Y(n20), .A(warmup_pattern_cnt[2]), .B(vector_cnt_lsb[2])
  );
  sg13g2_xnor2_1 U25(
      .Y(n19), .A(warmup_pattern_cnt[7]), .B(vector_cnt_lsb[7])
  );
  sg13g2_mux2_1 U26(
      .X(n25), .A0(ncp_limits_so), .A1(ccm_te_so_lbist_sib), .S(n5)
  );
  sg13g2_mux2_1 U27(
      .X(n26), .A0(counter_bist_scan_out), .A1(ccm_te_si), .S(n5)
  );
  sg13g2_mux2_1 U28(
      .X(n27), .A0(ncp_limits_so_retime), .A1(ncp_limits_so), .S(n5)
  );
  sg13g2_mux2_1 U29(
      .X(n28), .A0(counter_bist_scan_out_retime), .A1(ncp[0]), .S(n5)
  );
  sg13g2_inv_1 U30(
      .Y(n29), .A(ijtag_tck)
  );
  sg13g2_mux2_1 U31(
      .X(n30), .A0(lbist_scan_in), .A1(ccm_le_si), .S(n8)
  );
  sg13g2_nand2_1 U32(
      .Y(ncp_limits_scan_en), .A(n3), .B(n23)
  );
  sg13g2_nand3_1 U33(
      .Y(n23), .A(ncp_limits_sib_to_enable), .B(lbist_en), .C(ijtag_se)
