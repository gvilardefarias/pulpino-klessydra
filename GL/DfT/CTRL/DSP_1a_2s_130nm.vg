module DSP_gate2_tessent_sib_sri_ctrl(ijtag_reset, ijtag_sel, ijtag_si, ijtag_ce, 
                                      ijtag_se, ijtag_ue, ijtag_tck, ijtag_so, 
                                      ijtag_from_so, ijtag_to_sel);
  input  ijtag_reset, ijtag_sel, ijtag_si, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_tck, ijtag_from_so;
  output ijtag_so, ijtag_to_sel;

  wire sib_latch, sib, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n14, n15, 
       n16;

  sg13g2_dfrbp_1 to_enable_int_reg(
      .Q(), .Q_N(n10), .D(sib_latch), .RESET_B(ijtag_reset), .CLK(n14)
  );
  sg13g2_inv_1 U3(
