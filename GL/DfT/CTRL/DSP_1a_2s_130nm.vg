module DSP_gate2_tessent_lbist_counter(lbist_clock, lbist_scan_en, lbist_run_mode, 
                                       reset, ccm_scan_en, ccm_le_si, ccm_le_so, 
                                       shift_phase, prpg_en, lbist_burn_in, lbist_reset, 
                                       lbist_scan_in, lbist_scan_out, ncp, ncp_0_limit, 
                                       ncp_1_limit, last_bit, vector_cnt_lsb, last_vector);
  input  [7:0] ncp_0_limit, ncp_1_limit;
  input  lbist_clock, lbist_scan_en, lbist_run_mode, reset, ccm_scan_en, 
         ccm_le_si, shift_phase, prpg_en, lbist_burn_in, lbist_reset, 
         lbist_scan_in;
  output [7:0] vector_cnt_lsb;
  output [0:0] ncp;
  output ccm_le_so, lbist_scan_out, last_bit, last_vector;

  wire [10:8] vector_cnt;
  wire [10:0] new_vector_cnt;
