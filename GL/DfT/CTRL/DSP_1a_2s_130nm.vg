  sg13g2_inv_1 U15(
      .Y(n17), .A(n9)
  );
  sg13g2_a22oi_1 U16(
      .Y(n9), .A1(new_ncp_cnt[3]), .A2(n4), .B1(n2), .B2(ncp_cnt[4])
