  output edt_channels_out_from_controller, ccm_le_so, ccm_te_so, ijtag_so, 
         edt_chain_mask_load_en_BAR;

  wire [9:0] xor_decoded_masks_0, onehot_decoded_masks_0;
  wire [6:1] masks_shift_reg_0;
  wire [5:0] masks_hold_reg_0;
