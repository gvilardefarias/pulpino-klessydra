      .Y(n1), .A1(sib), .A2(n2), .B1(sib_latch), .B2(n3)
  );
  sg13g2_inv_1 U5(
      .Y(n2), .A(n3)
  );
  sg13g2_nand2_1 U6(
      .Y(n3), .A(ijtag_ue), .B(ijtag_sel)
  );
  sg13g2_inv_1 U7(
