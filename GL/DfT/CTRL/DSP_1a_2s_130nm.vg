                                           ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
                                           ijtag_se, ijtag_ue, ccm_en, ccm_scan_en, 
                                           ccm_le_si, ccm_le_so, ccm_te_si, ccm_te_so, 
                                           ijtag_si, ijtag_so, edt_chain_mask_load_en_BAR);
  input  edt_clock, edt_update, edt_channels_in, lbist_reset, lbist_en, 
         ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, 
         ccm_en, ccm_scan_en, ccm_le_si, ccm_te_si, ijtag_si;
