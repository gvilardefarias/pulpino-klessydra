  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_4_(
      .Q(), .Q_N(ncp_0_limit[4]), .D(n22), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_3_(
      .Q(), .Q_N(ncp_0_limit[3]), .D(n23), .RESET_B(n10), .CLK(n6)
  );
  sg13g2_dfrbp_1 ncp_0_limit_reg_2_(
      .Q(), .Q_N(ncp_0_limit[2]), .D(n24), .RESET_B(n10), .CLK(n6)
