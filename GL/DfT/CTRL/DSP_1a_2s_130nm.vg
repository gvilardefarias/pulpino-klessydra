  sg13g2_inv_1 U5(
      .Y(n12), .A(n3)
  );
  sg13g2_a22oi_1 U6(
      .Y(n3), .A1(new_ncp_cnt[6]), .A2(n4), .B1(scan_en), .B2(ncp_cnt[7])
