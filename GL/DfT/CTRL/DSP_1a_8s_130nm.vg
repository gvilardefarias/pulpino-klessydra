  sg13g2_mux2_1 U15(
      .X(n20), .A0(n15), .A1(n18), .S(n2)
  );
  sg13g2_nor2_1 U16(
      .Y(n15), .A(ncp_0_limit[6]), .B(lbist_reset)
  );
  sg13g2_a221oi_1 U17(
      .Y(n21), .A1(ncp_0_limit[6]), .A2(n2), .B1(ncp_0_limit[5]), .B2(n8), .C1(n9)
  );
  sg13g2_a221oi_1 U18(
      .Y(n22), .A1(ncp_0_limit[5]), .A2(n3), .B1(ncp_0_limit[4]), .B2(n8), .C1(n9)
