           dsp_sci_we, dsp_sci_req, state_DSP, ijtag_tck, ijtag_reset, ijtag_ce, 
           ijtag_se, ijtag_ue, ijtag_sel, ijtag_si, ijtag_so, scan_enable, edt_update, 
           test_clock, DSP_gate2_controller_c1_edt_channels_in, DSP_gate2_controller_c1_edt_channels_out, 
           ccm_scan_in0, ccm_scan_out0, ts_ext_mode_si, ts_ext_mode_so);
