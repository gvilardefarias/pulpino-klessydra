      .encoded_masks({masks_hold_reg_0[0], masks_hold_reg_0[1], 
      masks_hold_reg_0[2], masks_hold_reg_0[3], masks_hold_reg_0[4], 
      masks_hold_reg_0[5]}), .decoded_masks_0(xor_decoded_masks_0)
  );
  DSP_gate2_tessent_edt_c1_onehot_decoder_4_to_10 decoder1(
      .encoded_masks({masks_hold_reg_0[5], n61, masks_hold_reg_0[3:2]}), .decoded_masks(onehot_decoded_masks_0)
  );
