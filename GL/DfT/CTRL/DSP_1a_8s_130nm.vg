  sg13g2_a221oi_1 U27(
      .Y(n31), .A1(ncp_1_limit[3]), .A2(n3), .B1(ncp_1_limit[2]), .B2(n12), .C1(n14)
  );
  sg13g2_a221oi_1 U28(
      .Y(n32), .A1(ncp_1_limit[2]), .A2(n4), .B1(ncp_1_limit[1]), .B2(n12), .C1(n14)
  );
  sg13g2_inv_1 U29(
      .Y(n33), .A(n16)
  );
  sg13g2_a22oi_1 U30(
      .Y(n16), .A1(n8), .A2(ncp_0_limit[7]), .B1(ncp_1_limit[0]), .B2(n2)
  );
  sg13g2_nor2_1 U31(
      .Y(n12), .A(n2), .B(n14)
  );
  sg13g2_nor2b_1 U32(
