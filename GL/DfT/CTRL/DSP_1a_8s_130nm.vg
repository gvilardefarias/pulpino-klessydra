  sg13g2_dfrbp_1 ncp_1_limit_reg_2_(
      .Q(), .Q_N(ncp_1_limit[2]), .D(n31), .RESET_B(n11), .CLK(n7)
  );
  sg13g2_dfrbp_1 ncp_1_limit_reg_1_(
      .Q(), .Q_N(ncp_1_limit[1]), .D(n32), .RESET_B(n11), .CLK(n7)
  );
  sg13g2_dfrbp_1 ncp_1_limit_reg_0_(
      .Q(), .Q_N(ncp_1_limit[0]), .D(n26), .RESET_B(n11), .CLK(n7)
