module DSP_gate2_tessent_single_chain_mode_logic_sib_1(ijtag_tck, ijtag_reset, 
                                                       ijtag_sel, ijtag_ce, ijtag_se, 
                                                       ijtag_ue, ijtag_si, ijtag_from_so, 
                                                       ccm_scan_en, ccm_te_si, 
                                                       ccm_te_so, ijtag_so, ijtag_to_sel);
  input  ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_si, ijtag_from_so, ccm_scan_en, ccm_te_si;
  output ccm_te_so, ijtag_so, ijtag_to_sel;

  wire sib_latch, sib, n1, n3, n5, n7, n8, n9, n10, n11, n12, n13, n14, n15, 
       n16, n17, n18, n19, n20, n22, n23;

  sg13g2_dfrbp_1 sib_reg(
      .Q(sib), .Q_N(), .D(n18), .RESET_B(ijtag_reset), .CLK(ijtag_tck)
  );
  sg13g2_dfrbp_1 sib_latch_reg(
      .Q(sib_latch), .Q_N(), .D(n19), .RESET_B(ijtag_reset), .CLK(n20)
  );
  sg13g2_dfrbp_1 to_enable_int_reg(
      .Q(), .Q_N(n1), .D(sib_latch), .RESET_B(n23), .CLK(n20)
  );
  sg13g2_dfrbp_1 so_retime_reg(
      .Q(ccm_te_so), .Q_N(), .D(n22), .RESET_B(n23), .CLK(n20)
  );
  sg13g2_tiehi U3(
      .L_HI(n23)
  );
  sg13g2_inv_1 U4(
      .Y(n20), .A(ijtag_tck)
  );
  sg13g2_o21ai_1 U5(
      .Y(n22), .A1(n3), .A2(n1), .B1(n5)
  );
  sg13g2_a21o_1 U6(
      .X(n18), .A1(ijtag_from_so), .A2(n7), .B1(n8)
  );
  sg13g2_mux2_1 U7(
      .X(n8), .A0(n9), .A1(n10), .S(n11)
  );
  sg13g2_nor2b_1 U8(
      .Y(n10), .A(sib_latch), .B_N(ijtag_si)
  );
  sg13g2_a21oi_1 U9(
      .Y(n9), .A1(ijtag_ce), .A2(ijtag_sel), .B1(n5)
  );
  sg13g2_a21o_1 U10(
      .X(n7), .A1(n11), .A2(sib_latch), .B1(ccm_scan_en)
  );
  sg13g2_nor4_1 U11(
      .Y(n11), .A(n12), .B(n13), .C(ccm_scan_en), .D(ijtag_ce)
  );
  sg13g2_inv_1 U12(
      .Y(n13), .A(ijtag_se)
  );
  sg13g2_a21o_1 U13(
      .X(n19), .A1(n14), .A2(n15), .B1(n16)
  );
  sg13g2_mux2_1 U14(
      .X(n16), .A0(n17), .A1(ccm_te_si), .S(ccm_scan_en)
  );
  sg13g2_nor2b_1 U15(
      .Y(n17), .A(n14), .B_N(sib_latch)
  );
  sg13g2_inv_1 U16(
      .Y(n15), .A(n5)
  );
  sg13g2_nand2_1 U17(
      .Y(n5), .A(sib), .B(n3)
  );
  sg13g2_inv_1 U18(
      .Y(n3), .A(ccm_scan_en)
  );
  sg13g2_nor2b_1 U19(
      .Y(n14), .A(n12), .B_N(ijtag_ue)
  );
  sg13g2_nor2_1 U20(
      .Y(ijtag_to_sel), .A(n1), .B(n12)
  );
  sg13g2_inv_1 U21(
      .Y(n12), .A(ijtag_sel)
  );
  sg13g2_mux2_1 U22(
      .X(ijtag_so), .A0(ccm_te_so), .A1(sib), .S(ccm_scan_en)
  );
endmodule

