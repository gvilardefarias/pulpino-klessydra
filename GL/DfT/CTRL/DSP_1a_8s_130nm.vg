      .Q(warmup_pattern_cnt[4]), .Q_N(), .D(n16), .RESET_B(n3), .CLK(n2)
  );
  sg13g2_dfrbp_1 warmup_pattern_cnt_reg_3_(
      .Q(warmup_pattern_cnt[3]), .Q_N(), .D(n15), .RESET_B(n3), .CLK(n2)
  );
  sg13g2_dfrbp_1 warmup_pattern_cnt_reg_2_(
      .Q(warmup_pattern_cnt[2]), .Q_N(), .D(n14), .RESET_B(n3), .CLK(n2)
  );
  sg13g2_dfrbp_1 warmup_pattern_cnt_reg_1_(
      .Q(warmup_pattern_cnt[1]), .Q_N(), .D(n13), .RESET_B(n3), .CLK(n2)
  );
  sg13g2_dfrbp_1 warmup_pattern_cnt_reg_0_(
      .Q(scan_out), .Q_N(), .D(n20), .RESET_B(n3), .CLK(n2)
  );
  sg13g2_buf_1 U3(
      .X(n1), .A(lbist_scan_en)
  );
  sg13g2_buf_1 U4(
      .X(n2), .A(lbist_clock)
  );
  sg13g2_buf_1 U5(
      .X(n3), .A(reset)
  );
  sg13g2_inv_1 U6(
      .Y(n13), .A(n4)
  );
  sg13g2_a22oi_1 U7(
      .Y(n4), .A1(warmup_pattern_cnt[1]), .A2(n5), .B1(warmup_pattern_cnt[2]), 
