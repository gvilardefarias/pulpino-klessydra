module DSP_gate2_tessent_lbist_ncp_reg(lbist_clock, reset, scan_en, scan_in, lbist_reset, 
                                       new_ncp_cnt, ncp_cnt);
  input  [7:0] new_ncp_cnt;
  input  lbist_clock, reset, scan_en, scan_in, lbist_reset;
  output [7:0] ncp_cnt;

  wire n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, 
       n17, n18, n19;

  sg13g2_dfrbp_1 ncp_cnt_reg_7_(
      .Q(ncp_cnt[7]), .Q_N(), .D(n13), .RESET_B(reset), .CLK(n1)
  );
  sg13g2_dfrbp_1 ncp_cnt_reg_6_(
      .Q(ncp_cnt[6]), .Q_N(), .D(n12), .RESET_B(reset), .CLK(n1)
  );
