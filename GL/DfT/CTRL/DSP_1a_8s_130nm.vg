  );
  sg13g2_nand2b_1 U6(
      .Y(n2), .A_N(lbist_reset), .B(n4)
  );
endmodule

module DSP_gate2_tessent_lbist_ctrl(lbist_clock, lbist_en, ccm_scan_en, ccm_le_si, 
                                    ccm_le_so, ccm_te_si, ccm_te_so, capture_phase_size, 
                                    lbist_scan_in, lbist_scan_out, shift_phase, 
                                    lbist_reset, lbist_run_mode, lbist_burn_in, 
                                    prpg_en, warmup_done, ncp, last_bit, last_vector, 
                                    ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
                                    ijtag_se, ijtag_ue);
  input  lbist_clock, lbist_en, ccm_scan_en, ccm_le_si, ccm_te_si, 
         lbist_scan_in, shift_phase, lbist_reset, lbist_run_mode, 
         lbist_burn_in, prpg_en, ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
         ijtag_se, ijtag_ue;
  output [1:0] capture_phase_size;
  output [0:0] ncp;
  output ccm_le_so, ccm_te_so, lbist_scan_out, warmup_done, last_bit, 
         last_vector;

  wire [7:0] vector_cnt_lsb, warmup_pattern_cnt, ncp_0_limit, ncp_1_limit;
  wire sib_to_enable, ncp_limits_sib_to_enable, ncp_limits_scan_en, 
       capture_phase_size_so, warmup_pattern_cnt_so, lbist_counter_ccm_le_so, 
       counter_bist_scan_out, counter_bist_scan_out_retime, 
       ccm_te_so_lbist_sib, lbist_sib_scan_out, ncp_limits_ccm_le_so, 
       ncp_limits_so, ncp_limits_so_retime, n4, n1, n2, n3, n5, n6, n7, n8, n9, 
       n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n22, n23, 
       n24, n25, n26, n27, n28, n29, n30;

  assign lbist_scan_out = ccm_le_so;
