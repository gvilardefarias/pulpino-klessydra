      .B2(lbist_scan_en)
  );
  sg13g2_inv_1 U10(
      .Y(n15), .A(n7)
  );
  sg13g2_a22oi_1 U11(
      .Y(n7), .A1(warmup_pattern_cnt[3]), .A2(n5), .B1(warmup_pattern_cnt[4]), 
